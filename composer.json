{
  "name": "flexi/flexi-module-devtools",
  "description": "Development tools module for Flexi Framework",
  "version": "2.0.0",
  "type": "flexi-module",
  "license": "MIT",
  "keywords": [
    "flexi",
    "module",
    "devtools",
    "development",
    "debugging"
  ],
  "authors": [
    {
      "name": "Carlos Batista",
      "email": "info@carlosbatista.dev",
      "homepage": "https://carlosbatista.dev"
    }
  ],
  "require": {
    "php": ">=7.4",
    "flexi/contracts": "^5.2.1"
  },
  "autoload": {
    "psr-4": {
      "Flexi\\Modules\\DevTools\\": ""
    }
  },
  "extra": {
    "flexi": {
      "module-name": "DevTools",
      "module-type": "application",
      "config-files": [
        "Config/commands.json",
        "Config/queries.json"
      ],
      "provides": [
        "development-commands",
        "debugging-tools"
      ],
      "schema-version": 1,
      "compatibility": {
        "core": "^3.2"
      }
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Flexi\\Modules\\DevTools\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  }
}
